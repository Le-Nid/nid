{
  "name": "nid-backend",
  "version": "0.2.1",
  "type": "module",
  "description": "Nid backend API — Fastify + TypeScript + Kysely",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--dns-result-order=ipv4first' vite-node --watch src/index.ts",
    "build": "vite build",
    "start": "NODE_OPTIONS='--dns-result-order=ipv4first' node dist/index.js",
    "typecheck": "tsc --noEmit",
    "check": "npm ci && npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.4",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "archiver": "^7.0.1",
    "arctic": "^3.7.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.81.5",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.7",
    "googleapis": "^171.4.0",
    "imapflow": "^1.7.8",
    "ioredis": "^5.11.1",
    "kysely": "^0.29.7",
    "mailparser": "^3.12.4",
    "nodemailer": "^10.1.1",
    "otplib": "^13.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/imapflow": "^1.0.189",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^25.9.9",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
